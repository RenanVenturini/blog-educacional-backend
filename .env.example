
# --- API ---
PORT=3000

# --- Banco de dados (lido por src/config/database.js) ---
DB_USER=sa
DB_PASSWORD=troque-esta-senha-Forte123
DB_NAME=BlogEducacional
DB_PORT=1433

# Rodando a API na máquina (npm run dev)  -> localhost
# Rodando a API dentro do Docker Compose  -> database (nome do serviço)
DB_SERVER=localhost

# --- Container do SQL Server (lido pelo docker-compose.yml) ---
ACCEPT_EULA=Y
MSSQL_PID=Developer

# --- Autenticacao (JWT) ---
# Gere um segredo proprio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio
JWT_EXPIRES_IN=8h


